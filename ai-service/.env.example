# OneHealth AI - AI service configuration (copy to .env and edit)
# NEVER commit the real .env file.

PORT=8001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- OCR (optional) ---------------------------------------------------------
# Digitally generated PDFs are read from their text layer and need NO OCR engine.
# Tesseract is only required for images and scanned PDFs. If it is installed in a
# non-standard location, point at it here, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_DPI=200
MAX_OCR_PAGES=10

# --- LLM (optional) ---------------------------------------------------------
# With no key the service uses its deterministic summary generator, which is a
# fully supported path - the product works offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
