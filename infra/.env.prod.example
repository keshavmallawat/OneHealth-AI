# Copy to infra/.env.prod and replace every value. NEVER commit infra/.env.prod.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Exactly 32 characters.
PII_ENCRYPTION_KEY=
PII_HMAC_SECRET=

# Where users reach the app (used for CORS).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Optional: LLM-worded summaries. Leave empty to use the deterministic summary.
OPENAI_API_KEY=

# Optional: S3 storage instead of the uploads volume.
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
