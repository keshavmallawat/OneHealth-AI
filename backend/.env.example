# OneHealth AI - backend configuration
# Copy to .env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Default: the PostgreSQL started by infra/docker-compose.yml (port 5433, so it
# cannot collide with a PostgreSQL already installed on the host).
#   cd infra && docker compose up -d
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/healthcareai
#
# Using a PostgreSQL installed directly on this machine instead? That normally
# owns port 5432:
#   DATABASE_URL=postgresql://postgres:YOURPASSWORD@127.0.0.1:5432/healthcareai

# --- Auth secrets (generate your own) ---------------------------------------
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-value

# PII_ENCRYPTION_KEY must be EXACTLY 32 characters (AES-256-GCM key).
PII_ENCRYPTION_KEY=change_me_to_exactly_32_chars!!!
PII_HMAC_SECRET=change-me-too

# --- Storage ----------------------------------------------------------------
# 'local' keeps everything on this machine and needs no AWS account.
# 's3' uses the S3 implementation in src/services/s3.service.ts.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=storage
MAX_UPLOAD_MB=25

# Only needed when STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=healthcare-ai-records

# --- AI service -------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=120000

# --- Redis (optional) -------------------------------------------------------
# Used for OTP, rate limiting and refresh-token revocation. If it is not
# running the app falls back to an in-process store and keeps working.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
